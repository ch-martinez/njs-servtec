<main class="main">
    <main class="container container--box">

        <section class="wrapper">
            <section class="wrapper__header">
                <div>
                    <h2 class="wrapper__title">Fotos evidencia</h2>
                    <p class="wrapper__desc">A continuacion cargue las fotos. (Maximo 10 imagenes)</p>
                </div>
            </section>
            <section class="wrapper__body">
                <form class="wrapper__group wrapper__group--box" action="/order/<%= oid %>/image/upload" method="post"
                    id="form_multi" enctype="multipart/form-data">

                    <div class="fu-container">
                        <div class="fu__preview">
                            <ul class="fu__ul"></ul>
                        </div>
                        <label for="images" class="btn ">
                            <input type="file" name="images" id="images" class="input" required multiple accept="image/*" max="10" hidden>
                            <img src="/img/cloud-upload.svg" alt="">
                            <span class="">Haga click para subir imagenes</span>
                        </label>
                    </div>

                    <div class="wrapper__item wrapper__item--inline">
                        <a href="/order/<%= oid %>" class="btn btn--gray btn--full">Cancelar</a>
                        <button class="btn btn--full" type="submit">Guardar</button>
                    </div>
                </form>
            </section>
        </section>
    </main>
</main>